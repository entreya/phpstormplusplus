{
  "name": "phpstormplusplus",
  "displayName": "PHPStorm++",
  "description": "PhpStorm-style IDE features for PHP in VS Code: code intelligence, refactorings, live templates, Xdebug debugging, and pluggable framework support (starting with Yii2).",
  "version": "0.11.3",
  "publisher": "phpstormplusplus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php",
    "workspaceContains:**/*.php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "php",
        "extensions": [
          ".php",
          ".phtml"
        ]
      }
    ],
    "commands": [
      {
        "command": "phpstormpp.extractVariable",
        "title": "PHPStorm++: Extract Variable"
      },
      {
        "command": "phpstormpp.extractMethod",
        "title": "PHPStorm++: Extract Method"
      },
      {
        "command": "phpstormpp.generateConstructor",
        "title": "PHPStorm++: Generate Constructor"
      },
      {
        "command": "phpstormpp.generateGettersSetters",
        "title": "PHPStorm++: Generate Getters and Setters"
      },
      {
        "command": "phpstormpp.generatePhpDoc",
        "title": "PHPStorm++: Generate PHPDoc"
      },
      {
        "command": "phpstormpp.optimizeImports",
        "title": "PHPStorm++: Optimize Imports"
      },
      {
        "command": "phpstormpp.generate",
        "title": "PHPStorm++: Generate..."
      },
      {
        "command": "phpstormpp.openTerminal",
        "title": "PHPStorm++: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "phpstormpp.yii2.goToController",
        "title": "PHPStorm++: Yii2 - Go to Controller"
      },
      {
        "command": "phpstormpp.yii2.goToView",
        "title": "PHPStorm++: Yii2 - Go to View"
      },
      {
        "command": "phpstormpp.reindex",
        "title": "PHPStorm++: Rebuild PHP Index"
      },
      {
        "command": "phpstormpp.searchEverywhere",
        "title": "PHPStorm++: Search Everywhere"
      },
      {
        "command": "phpstormpp.newPhpClass",
        "title": "PHPStorm++: New PHP Class..."
      },
      {
        "command": "phpstormpp.checkForUpdates",
        "title": "PHPStorm++: Check for Updates"
      },
      {
        "command": "phpstormpp.openCommandCenter",
        "title": "PHPStorm++: Open Command Center"
      }
    ],
    "submenus": [
      {
        "id": "phpstormpp.refactorMenu",
        "label": "Refactor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "phpstormpp.newPhpClass",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "phpstormpp.refactorMenu",
          "when": "editorLangId == php",
          "group": "1_modification@1"
        },
        {
          "command": "phpstormpp.generate",
          "when": "editorLangId == php",
          "group": "1_modification@2"
        },
        {
          "command": "phpstormpp.generatePhpDoc",
          "when": "editorLangId == php",
          "group": "1_modification@3"
        },
        {
          "command": "phpstormpp.optimizeImports",
          "when": "editorLangId == php",
          "group": "1_modification@4"
        }
      ],
      "phpstormpp.refactorMenu": [
        {
          "command": "editor.action.rename",
          "when": "editorLangId == php",
          "group": "1_rename@1"
        },
        {
          "command": "phpstormpp.extractVariable",
          "when": "editorLangId == php",
          "group": "2_extract@1"
        },
        {
          "command": "phpstormpp.extractMethod",
          "when": "editorLangId == php",
          "group": "2_extract@2"
        }
      ],
      "view/title": [
        {
          "command": "phpstormpp.openTerminal",
          "when": "view == phpstormpp.main",
          "group": "navigation@0"
        }
      ]
    },
    "views": {
      "phpstormpp": [
        {
          "id": "phpstormpp.main",
          "name": "PHPStorm++",
          "type": "webview"
        }
      ],
      "phpstormppPreviewPanel": [
        {
          "id": "phpstormpp.preview",
          "name": "Search Everywhere Preview",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "phpstormpp",
          "title": "PHPStorm++",
          "icon": "resources/terminal.svg"
        }
      ],
      "panel": [
        {
          "id": "phpstormppPreviewPanel",
          "title": "PHPStorm++ Preview",
          "icon": "resources/preview.svg"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "php"
      }
    ],
    "debuggers": [
      {
        "type": "phpstormpp-xdebug",
        "label": "PHPStorm++ Xdebug",
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "port": {
                "type": "number",
                "default": 9003
              },
              "pathMappings": {
                "type": "object",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "phpstormpp-xdebug",
            "request": "launch",
            "name": "Listen for Xdebug (PHPStorm++)",
            "port": 9003
          }
        ]
      }
    ],
    "themes": [
      {
        "label": "PHPStorm++ Dark (Darcula-inspired)",
        "uiTheme": "vs-dark",
        "path": "./themes/phpstormpp-dark-color-theme.json"
      },
      {
        "label": "PHPStorm++ Light",
        "uiTheme": "vs",
        "path": "./themes/phpstormpp-light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "PHPStorm++",
      "properties": {
        "phpstormpp.liveTemplates": {
          "type": "array",
          "default": [],
          "description": "Custom Live Templates (PhpStorm-style abbreviation snippets) in addition to the built-in set."
        },
        "phpstormpp.frameworks.enabled": {
          "type": "array",
          "default": [
            "yii2"
          ],
          "description": "Framework support modules to enable."
        }
      }
    },
    "extensionPack": [
      "phantriviethoang.phpstorm-icon"
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "PHPStorm++ Dark (Darcula-inspired)",
      "workbench.iconTheme": "phpstorm-icon",
      "workbench.sideBar.location": "left",
      "workbench.panel.defaultLocation": "bottom",
      "workbench.activityBar.location": "default",
      "workbench.editor.showTabs": "multiple",
      "workbench.tree.renderIndentGuides": "always",
      "breadcrumbs.enabled": true,
      "explorer.autoReveal": true,
      "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, Menlo, monospace",
      "editor.fontLigatures": true,
      "editor.fontSize": 16,
      "editor.lineHeight": 1.35,
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false,
      "editor.rulers": [
        120
      ],
      "editor.trimAutoWhitespace": true,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "editor.matchBrackets": "always",
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": true,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.stickyScroll.enabled": true,
      "editor.minimap.enabled": true,
      "editor.minimap.renderCharacters": false,
      "editor.wordWrap": "off",
      "editor.linkedEditing": true,
      "editor.suggestSelection": "first",
      "editor.snippetSuggestions": "top",
      "explorer.compactFolders": false,
      "workbench.editor.highlightModifiedTabs": true,
      "workbench.tree.indent": 16,
      "search.searchOnType": true,
      "search.searchOnTypeDebouncePeriod": 300,
      "search.smartCase": true,
      "search.showLineNumbers": true,
      "search.followSymlinks": false,
      "[php]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
          120
        ]
      }
    },
    "keybindings": [
      {
        "command": "phpstormpp.searchEverywhere",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "phpstormpp.openCommandCenter",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "workbench.action.showCommands",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "workbench.view.explorer",
        "key": "alt+1",
        "mac": "cmd+1"
      },
      {
        "command": "workbench.action.tasks.build",
        "key": "ctrl+shift+f9",
        "mac": "cmd+shift+f9"
      },
      {
        "command": "editor.action.quickFix",
        "when": "editorTextFocus",
        "key": "alt+enter",
        "mac": "alt+enter"
      },
      {
        "command": "workbench.action.showAllEditorsByMostRecentlyUsed",
        "key": "ctrl+e",
        "mac": "cmd+e"
      },
      {
        "command": "editor.action.referenceSearch.trigger",
        "when": "editorTextFocus",
        "key": "alt+f7",
        "mac": "alt+f7"
      },
      {
        "command": "workbench.action.openSettings",
        "key": "ctrl+alt+s"
      },
      {
        "command": "phpstormpp.generate",
        "when": "editorTextFocus",
        "key": "alt+insert",
        "mac": "cmd+n"
      },
      {
        "command": "workbench.action.debug.selectandstart",
        "key": "alt+shift+f9",
        "mac": "ctrl+alt+d"
      },
      {
        "command": "workbench.view.debug",
        "key": "ctrl+shift+f8",
        "mac": "cmd+shift+f8"
      },
      {
        "command": "workbench.view.scm",
        "key": "alt+`",
        "mac": "ctrl+v"
      },
      {
        "command": "editor.action.refactor",
        "when": "editorTextFocus",
        "key": "ctrl+alt+shift+t",
        "mac": "ctrl+t"
      },
      {
        "command": "editor.action.formatDocument",
        "when": "editorTextFocus",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "workbench.action.tasks.build",
        "key": "ctrl+f9",
        "mac": "cmd+f9"
      },
      {
        "command": "editor.action.deleteLines",
        "when": "editorTextFocus",
        "key": "ctrl+y",
        "mac": "cmd+backspace"
      },
      {
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus",
        "key": "ctrl+d",
        "mac": "cmd+d"
      },
      {
        "command": "editor.action.joinLines",
        "when": "editorTextFocus",
        "key": "ctrl+shift+j"
      },
      {
        "command": "workbench.action.files.newUntitledFile",
        "key": "ctrl+alt+shift+insert",
        "mac": "cmd+shift+n"
      },
      {
        "command": "editor.action.fontZoomIn",
        "key": "alt+shift+.",
        "mac": "ctrl+shift+."
      },
      {
        "command": "editor.action.fontZoomOut",
        "key": "alt+shift+,",
        "mac": "ctrl+shift+,"
