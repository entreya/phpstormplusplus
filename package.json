      },
      {
        "command": "workbench.action.terminal.toggleTerminal",
        "key": "alt+f12"
      },
      {
        "command": "workbench.view.extension.phpstormpp",
        "key": "alt+8",
        "mac": "cmd+8"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "pretest": "node esbuild.js && tsc -p test",
    "test": "node out-test/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.85.0",
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.20.0",
    "mocha": "^11.7.6",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "antd": "^6.6.0",
    "fast-xml-parser": "^5.10.1",
    "php-parser": "^3.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  }
}
